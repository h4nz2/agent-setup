# Allowlist: ignore everything in ~/.claude, then un-ignore tracked config only.
# Runtime state (projects/, sessions/, file-history/, chrome/, tasks/, teams/,
# plans/, .credentials.json, ...) can never leak in, including dirs added by
# future Claude Code releases.
/*

!/.gitignore
!/CLAUDE.md
!/README.md
!/settings.json
!/hooks/
!/output-styles/
!/skills/
!terminal_settings.json

# Anthropic skills synced from claude.ai at runtime (anthropic-skills:*)
/skills/synced/
